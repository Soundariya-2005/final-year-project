# ==============================================================================
# Environment Configuration Template
# Privacy-Preserving Adaptive Insider Threat Detection and Early Warning System
# ==============================================================================
# NOTE: Copy this file to .env and configure your credentials.
# Do NOT commit production secrets or real passwords to source control.

# Flask Application Settings
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key
PORT=5000

# ------------------------------------------------------------------------------
# Privacy-Preserving Configuration (HMAC Salt & Compliance Audit Key)
# ------------------------------------------------------------------------------
PSEUDONYM_SALT=replace-with-a-cryptographically-secure-random-salt-string
ADMIN_SECURITY_KEY=replace-with-an-authorized-compliance-officer-audit-key

# ------------------------------------------------------------------------------
# MySQL Database Connection Settings
# Configure EITHER individual parameters OR the full DATABASE_URL.
# ------------------------------------------------------------------------------
# Direct URL format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# Individual connection parameters:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=insider_threat_db
DB_USER=threat_user
DB_PASSWORD=

# Frontend API Configuration
VITE_API_BASE_URL=/api
